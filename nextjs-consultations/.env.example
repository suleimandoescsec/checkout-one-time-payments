BOOKING_STRIPE_ACCOUNT_ID=acct_your_expected_stripe_merchant
BOOKING_STRIPE_WEBHOOK_SECRET=
# Resend key with sending permission for verified suleimanalnsour.me.
BOOKING_RESEND_KEY=

